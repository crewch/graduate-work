model TestCase {
  testId         String @id @default(cuid()) @map("test_id")
  problemId      String @map("problem_id")
  inputData      String @map("input_data")
  expectedOutput String @map("expected_output")

  submissionResults SubmissionResult[]

  problem Problem @relation(fields: [problemId], references: [problemId])

  @@map("test_cases")
}
