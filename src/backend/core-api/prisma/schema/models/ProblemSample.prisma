model ProblemSample {
  sampleId     String  @id @default(cuid()) @map("sample_id")
  problemId    String  @map("problem_id")
  inputSample  String  @map("input_sample")
  outputSample String  @map("output_sample")
  explanation  String? @map("explanation")

  problem Problem @relation(fields: [problemId], references: [problemId])

  @@map("problem_samples")
}
