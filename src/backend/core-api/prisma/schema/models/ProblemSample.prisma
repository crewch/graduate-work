model ProblemSample {
  sampleId    String  @id @default(cuid()) @map("sample_id")
  problemId   String  @map("problem_id")
  input       String  @map("input")
  output      String  @map("output")
  explanation String? @map("explanation")

  problem Problem @relation(fields: [problemId], references: [problemId], onDelete: Cascade)

  @@map("problem_samples")
}
